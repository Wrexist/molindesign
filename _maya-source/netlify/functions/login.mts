import {scryptSync} from 'node:crypto';
import type {Config} from '@netlify/functions';
import {equal,issue,cors} from '../auth';
export default async (req:Request)=>{const headers=cors(req);if(!headers)return new Response(null,{status:403});if(req.method==='OPTIONS')return new Response(null,{status:204,headers});const json=(v:unknown,status=200)=>Response.json(v,{status,headers});if(req.method!=='POST')return json({error:'Metoden stöds inte.'},405);try{const password=Netlify.env.get('MAYA_PASSWORD_HASH'),secret=Netlify.env.get('SESSION_SECRET');if(!password||!secret)return json({error:'Inloggningen är inte konfigurerad.',configuration:{password:!!password,session:!!secret,context:Netlify.context?.deploy.context}},503);const text=await req.text();if(text.length>1000)return json({error:'Ogiltig begäran.'},400);const b=JSON.parse(text);if(typeof b.password!=='string'||b.password.length>200||!equal(scryptSync(b.password,password.split(':')[0],64,{N:65536,maxmem:134217728}).toString('hex'),password.split(':')[1]||''))return json({error:'Koden stämmer inte.'},401);return json({token:issue(secret)});}catch{return json({error:'Inloggningen misslyckades.'},400);}};
export const config:Config={path:'/api/login',rateLimit:{windowLimit:10,windowSize:60,aggregateBy:['ip'],action:'rate_limit'}};
